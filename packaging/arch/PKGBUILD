# Maintainer: TatsuyaM2667
pkgname=ame-filemanager-git
pkgver=r0
pkgrel=1
pkgdesc="Translucent GNOME Files-style file manager in pure Odin (Wayland), with Filee-style conversion"
arch=(x86_64 aarch64)
url="https://github.com/TatsuyaM2667/ame-Filemanager"
license=(MIT)
depends=(wayland libxkbcommon freetype2 libarchive xdg-utils ttf-nerd-fonts-symbols noto-fonts-cjk)
optdepends=('ffmpeg: image/video/audio conversion and previews'
            'pandoc: document conversion'
            'libreoffice-fresh: office → PDF'
            'imagemagick: image → PDF'
            'adwaita-fonts: GNOME look')
makedepends=(odin git)
provides=(ame-filemanager)
conflicts=(glassfilee-git)
source=("git+$url.git")
sha256sums=(SKIP)

pkgver() {
    cd ame-Filemanager
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd ame-Filemanager
    odin build src/gui -out:ame-filemanager -o:speed
}

package() {
    cd ame-Filemanager
    install -Dm755 ame-filemanager "$pkgdir/usr/bin/ame-filemanager"
    install -Dm644 ame-filemanager.desktop "$pkgdir/usr/share/applications/ame-filemanager.desktop"
    install -Dm644 assets/ame-filemanager.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ame-filemanager.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
