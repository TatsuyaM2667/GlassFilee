package main

// Thumbnails for images and videos, generated by ffmpeg in the background and
// stored in the freedesktop cache (~/.cache/thumbnails/normal, shared with GNOME).
// Only on-screen items are requested; old ones are evicted to keep memory small.

import "core:crypto/legacy/md5"
import "core:image"
import "core:os"
import "core:path/filepath"
import "core:strings"

THUMB_SIZE :: 128
MAX_THUMBS :: 240 // ~15 MB at most
MAX_THUMB_JOBS :: 4

Thumb_State :: enum u8 {
	Pending, Ready, Failed,
}

Thumb :: struct {
	state: Thumb_State,
	px:    []u32,
	w, h:  int,
	used:  u64, // frame it was last drawn in
}

thumbs: map[string]Thumb
thumb_jobs: int
frame_no: u64

@(private = "file")
cache_path :: proc(path: string) -> string {
	ctx: md5.Context
	md5.init(&ctx)
	uri := file_uri(path)
	md5.update(&ctx, transmute([]u8)uri)
	sum: [md5.DIGEST_SIZE]u8
	md5.final(&ctx, sum[:])
	hexd := "0123456789abcdef"
	name: [32]u8
	for b, i in sum {
		name[i * 2] = hexd[b >> 4]
		name[i * 2 + 1] = hexd[b & 15]
	}
	dir := os.get_env("XDG_CACHE_HOME", context.temp_allocator)
	if dir == "" do dir, _ = filepath.join({app.home, ".cache"}, context.temp_allocator)
	p, _ := filepath.join({dir, "thumbnails", "normal", strings.concatenate({string(name[:]), ".png"}, context.temp_allocator)}, context.temp_allocator)
	return p
}

@(private = "file")
free_thumb :: proc(key: string, t: Thumb) {
	delete(t.px)
	delete(key)
}

thumbs_clear :: proc() {
	for k, t in thumbs do free_thumb(k, t)
	clear(&thumbs)
}

@(private = "file")
evict :: proc() {
	@(static) last: u64
	if last == frame_no do return
	last = frame_no
	old := make([dynamic]string, context.temp_allocator)
	for k, t in thumbs do if t.state != .Pending && frame_no - t.used > 2 do append(&old, k)
	for k in old {
		t := thumbs[k]
		delete_key(&thumbs, k)
		free_thumb(k, t)
	}
}

// Returns the thumbnail if ready (starts generating it otherwise).
thumb_get :: proc(path: string, mtime: i64, video: bool) -> ^Thumb {
	if t, ok := &thumbs[path]; ok {
		t.used = frame_no
		return t if t.state == .Ready else nil
	}
	if len(thumbs) >= MAX_THUMBS do evict()
	cp := cache_path(path)
	if info, err := os.stat(cp, context.temp_allocator); err == nil && info.modification_time._nsec / 1_000_000_000 >= mtime {
		if img, ierr := image.load_from_file(cp, {.alpha_add_if_missing}, context.temp_allocator); ierr == nil && img.depth == 8 && img.channels == 4 {
			t := Thumb{state = .Ready, w = img.width, h = img.height, used = frame_no}
			t.px = make([]u32, t.w * t.h)
			src := img.pixels.buf[:]
			for i in 0 ..< t.w * t.h {
				a := u32(src[i * 4 + 3])
				t.px[i] = a << 24 | (u32(src[i * 4]) * a / 255) << 16 | (u32(src[i * 4 + 1]) * a / 255) << 8 | u32(src[i * 4 + 2]) * a / 255
			}
			thumbs[strings.clone(path)] = t
			return &thumbs[path]
		}
	}
	if !have_tool("ffmpeg") || thumb_jobs >= MAX_THUMB_JOBS do return nil
	_ = os.make_directory_all(filepath.dir(cp))
	tmp := strings.concatenate({cp, ".tmp.png"})
	vf := "thumbnail,scale=128:128:force_original_aspect_ratio=decrease" if video else "scale=128:128:force_original_aspect_ratio=decrease"
	pid := spawn({"ffmpeg", "-nostdin", "-v", "error", "-y", "-i", path, "-frames:v", "1", "-vf", vf, "-pix_fmt", "rgba", tmp})
	if pid == 0 {
		delete(tmp)
		return nil
	}
	append(&jobs, Job{pid = pid, kind = .Thumb, label = tmp, dest = strings.clone(cp), src = strings.clone(path)})
	thumb_jobs += 1
	thumbs[strings.clone(path)] = Thumb{state = .Pending, used = frame_no}
	return nil
}

thumb_done :: proc(j: Job, ok: bool) {
	thumb_jobs -= 1
	if ok && os.rename(j.label, j.dest) == nil {
		// drop the Pending entry: the next draw loads the fresh file
		if j.src in thumbs {
			k, t := delete_key(&thumbs, j.src)
			free_thumb(k, t)
		}
	} else {
		os.remove(j.label)
		if t, found := &thumbs[j.src]; found do t.state = .Failed
	}
}

// Draws a thumbnail fitted into an s×s icon box.
draw_thumb :: proc(x, y, s: f32, t: ^Thumb, video: bool) {
	sc := min(s / f32(t.w), s / f32(t.h))
	w, h := f32(t.w) * sc, f32(t.h) * sc
	r := Rect{x + (s - w) / 2, y + (s - h) / 2, w, h}
	rrect({r.x, r.y + px(2), r.w, r.h}, px(4), hex(0x000000, 60))
	blit_scaled(r, t.px, t.w, t.h)
	rrect(r, px(3), hex(0xffffff, 40), px(1))
	if video && s >= 40 do glyph_center({r.x + px(4), r.y + r.h - px(22), px(18), px(18)}, 0xf04b, fs(11), hex(0xffffff, 230))
}
